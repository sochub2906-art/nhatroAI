# Smart Rental Manager - Environment Variables
# Copy this file to .env, .env.host, or .env.admin and fill in real values

# App mode: leave empty for dev, 'host' for host app, 'admin' for admin app
VITE_APP_MODE=

# Firebase (shared project: nhatroai)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase (get from: Supabase Dashboard > Settings > API > anon public key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_starting_with_eyJ
