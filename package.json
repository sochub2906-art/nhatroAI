{
  "name": "smart-rental-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --mode host",
    "dev:admin": "vite --mode admin",
    "build": "vite build",
    "build:host": "vite build --mode host",
    "build:admin": "vite build --mode admin",
    "build:all": "npm run build:host && npm run build:admin",
    "deploy:host": "npm run build:host && firebase deploy --only hosting:nhatroai",
    "deploy:admin": "npm run build:admin && firebase deploy --only hosting:nhatrobe",
    "deploy:all": "npm run build:all && firebase deploy --only hosting",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "firebase": "^12.9.0",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
